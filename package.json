{
  "name": "mubendecountryresort-admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "build:cf": "next build --webpack && opennextjs-cloudflare build --skipNextBuild",
    "preview": "npm run build:cf && opennextjs-cloudflare preview",
    "deploy": "npm run build:cf && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "start": "next start",
    "admin:create-user": "node scripts/create-admin-user.mjs",
    "typecheck": "tsc --noEmit",
    "postinstall": "node scripts/copy-sqlite-wasm.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "@opennextjs/cloudflare": "^1.0.0",
    "@sqlite.org/sqlite-wasm": "^3.53.0-build1",
    "next": "^16.1.6",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zod": "^4.4.1"
  },
  "overrides": {
    "postcss": "8.5.10"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250320.0",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.21",
    "postcss": "8.5.10",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "wrangler": "^4.5.0"
  }
}
