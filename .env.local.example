# Used by `next dev` (Node.js runtime).
# For local Cloudflare Workers preview (`npm run preview`), set the same
# values in `.dev.vars` instead — wrangler does not read `.env.local`.

# Neon Postgres
DATABASE_URL=

# Optional: comma-separated list of allowed admin origins for POST guards.
# Leave unset to default to same-origin only.
# ADMIN_ALLOWED_ORIGINS=https://admin.mubendecountryresort.com
