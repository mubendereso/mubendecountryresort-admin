# Used by `wrangler dev` / `opennextjs-cloudflare preview` for local Workers
# runtime. Copy to `.dev.vars` and fill in real values. Never commit secrets.
#
# In production, set these via:
#   wrangler secret put DATABASE_URL
#   wrangler secret put ADMIN_ALLOWED_ORIGINS

DATABASE_URL=

# Required outside localhost. Comma-separated exact origins allowed to POST.
# ADMIN_ALLOWED_ORIGINS=https://admin.mubendecountryresort.com
